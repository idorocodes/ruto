PORT=8787
SOLANA_RPC_URL=https://api.devnet.solana.com

# Authority keypair: use ONE of the two.
# A JSON array of 64 numbers (contents of a solana-keygen id.json file):
AUTHORITY_SECRET_KEY=
# ...or a path to that JSON file:
# AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json

# CORS: "*" or a comma-separated list of origins, e.g. https://ruto.example.com,http://localhost:5173
ALLOWED_ORIGIN=*

DB_PATH=./ruto.db

# Optional: path to the Anchor IDL (default ./idl/ruto_program.json)
# IDL_PATH=./idl/ruto_program.json

# Optional: set to 1 when running behind ONE reverse proxy (Render, Railway, nginx...)
# so rate limiting sees the real client IP.
# TRUST_PROXY=1
